# ReturnIQ Enterprise — Production Environment Variables (Phase 8.5)
# Copy to .env on your production server.
# NEVER commit this file with real values.
# Store the real .env in a password manager or AWS Secrets Manager.

# ── REQUIRED secrets ──────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
API_KEY_HASH_PEPPER=REPLACE_WITH_DIFFERENT_64_CHAR_HEX

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=returniq
POSTGRES_USER=returniq
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# If using AWS RDS instead of Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://returniq:PASSWORD@rds-endpoint.ap-south-1.rds.amazonaws.com:5432/returniq

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# If using AWS ElastiCache:
# REDIS_URL=redis://your-cache.abc123.0001.aps1.cache.amazonaws.com:6379/0
USE_REDIS_RATE_LIMIT=true

# ── App settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEMO_MODE=false
COOKIE_SECURE=true
CORS_ORIGINS=https://YOUR_DOMAIN.com

# ── SMTP (required for password reset) ───────────────────────────────────────
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SMTP_FROM=noreply@YOUR_DOMAIN.com

# ── S3 file storage (optional — replaces local upload storage) ────────────────
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# AWS_REGION=ap-south-1
# S3_UPLOADS_BUCKET=returniq-production-uploads-123456789

# ── Backup S3 bucket ──────────────────────────────────────────────────────────
# S3_BUCKET=returniq-production-backups-123456789

# ── Monitoring ────────────────────────────────────────────────────────────────
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
