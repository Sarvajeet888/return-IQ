# ── Stage 1: dependency builder ───────────────────────────────────────────────
# Uses the full image so we can compile wheels, then we'll copy only the
# installed packages into the slim runtime image.
FROM python:3.11-slim AS builder

WORKDIR /build

# System deps for compilation
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libmagic1 \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies into a prefix we can COPY wholesale
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.title="ReturnIQ Backend"
LABEL org.opencontainers.image.description="AI-powered reverse logistics API"
LABEL org.opencontainers.image.version="3.0.0"

# Runtime system deps only (libmagic1 for python-magic, curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

WORKDIR /app

# Non-root user — created before copying app files so ownership is set correctly
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# Copy application code
COPY backend/ .

# Set correct ownership
RUN chown -R appuser:appuser /app

# Switch to non-root
USER appuser

# Expose API port
EXPOSE 8000

# Health check — FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Entrypoint: run migrations then start with gunicorn in production
# or uvicorn with --reload in development (overridden by docker-compose)
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4 --worker-class uvicorn.workers.UvicornWorker"]
