# Copy this file to `.env` in the project root and fill in real values.
# `.env` is gitignored - never commit real secrets.
#
# docker-compose automatically reads a `.env` file in the same directory as
# docker-compose.yml and substitutes ${VAR} references in it.

# ── Security (REQUIRED in any real deployment) ───────────────────────────────
# Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-generated-secret
API_KEY_HASH_PEPPER=replace-with-a-different-generated-secret

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=returniq
POSTGRES_USER=returniq
POSTGRES_PASSWORD=replace-with-a-strong-password

# ── App environment ───────────────────────────────────────────────────────
# "development" for local docker-compose use, "production" for a real
# deployment (this makes SECRET_KEY/API_KEY_HASH_PEPPER required and
# disables the auto-generated dev fallback).
ENVIRONMENT=development

# ── Cookies ───────────────────────────────────────────────────────────────
# Must be "true" whenever the app is served over HTTPS - the browser will
# silently refuse to store the refresh-token cookie over plain HTTP if this
# is true, and will happily leak it over plain HTTP if this is false. Only
# use "false" for local development on http://localhost.
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of exact frontend origins (protocol + host + port)
# allowed to make credentialed requests. Never use "*" here - it is
# incompatible with cookies/credentialed requests.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ── Demo / SMTP ───────────────────────────────────────────────────────────────
# DEMO_MODE seeds an organisation with a PUBLICLY KNOWN admin password
# (admin@sapnacollection.com / Demo@12345, role org_admin) and exposes demo
# API-key and password-reset-token endpoints. It exists so you can click
# around a working app without wiring SMTP first.
#
# Leave this commented out unless you specifically want that seed. The
# application defaults to DEMO_MODE=false, and REFUSES TO START if this is
# set to true while ENVIRONMENT=production.
#
# Uncomment for local development only:
# DEMO_MODE=true

# ── SMTP (REQUIRED in production) ─────────────────────────────────────────────
# Password reset and team invitations do not work without these. The app logs
# an ERROR at startup if ENVIRONMENT=production and SMTP is unconfigured.
# AWS SES example (ap-south-1):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Public frontend URL, used to build links inside emails.
# Falls back to the first CORS_ORIGINS entry if unset.
APP_BASE_URL=

# ── File storage ──────────────────────────────────────────────────────────────
# Set AWS_S3_BUCKET to use S3. Without it, uploads go to local disk - which
# means they are LOST when the container is replaced, and are not shared
# between replicas. Local is fine for demos, not for production.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LOCAL_UPLOAD_DIR=/app/uploads

# ── PII encryption ────────────────────────────────────────────────────────────
# Optional. If unset, the key is derived from SECRET_KEY via HKDF.
#
# IMPORTANT: while unset, rotating SECRET_KEY makes all stored customer PII
# unreadable. Set this explicitly if you need to rotate JWT signing keys
# independently of data encryption - which you eventually will.
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# ── Redis (optional, recommended for production) ──────────────────────────────
REDIS_URL=redis://redis:6379
USE_REDIS_RATE_LIMIT=false
